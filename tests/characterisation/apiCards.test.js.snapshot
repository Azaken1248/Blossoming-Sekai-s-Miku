12\\"/>\\n\\n    <text x=\\"312\\" y=\\"212\\" fill=\\"#94e2d5\\" font-size=\\"36\\" font-family=\\"Inter,Segoe UI,sans-serif\\" font-weight=\\"700\\">🌸 Hatsune Miku Superfan Deluxe</text>\\n    <text x=\\"312\\" y=\\"252\\" fill=\\"#bac2de\\" font-size=\\"24\\" font-family=\\"Inter,Segoe UI,sans-serif\\">ID: 100000000000000003</text>\\n    <text x=\\"312\\" y=\\"290\\" fill=\\"#cdd6f4\\" font-size=\\"22\\" font-family=\\"Inter,Segoe UI,sans-serif\\">Server Roles: 🎤 Voice Actor • Sound Engineer Supreme</text>\\n    <text x=\\"312\\" y=\\"322\\" fill=\\"#a6adc8\\" font-size=\\"20\\" font-family=\\"Inter,Segoe UI,sans-serif\\">Work Roles: VA • editor</text>\\n\\n    <rect x=\\"312\\" y=\\"350\\" width=\\"190\\" height=\\"54\\" rx=\\"27\\" fill=\\"#94e2d5\\" opacity=\\"0.2\\"/>\\n    <text x=\\"407\\" y=\\"384\\" text-anchor=\\"middle\\" fill=\\"#94e2d5\\" font-size=\\"22\\" font-family=\\"Inter,Segoe UI,sans-serif\\" font-weight=\\"700\\">Active</text>\\n\\n    <rect x=\\"524\\" y=\\"350\\" width=\\"220\\" height=\\"54\\" rx=\\"27\\" fill=\\"#f5c2e7\\" opacity=\\"0.2\\"/>\\n    <text x=\\"634\\" y=\\"384\\" text-anchor=\\"middle\\" fill=\\"#f5c2e7\\" font-size=\\"22\\" font-family=\\"Inter,Segoe UI,sans-serif\\" font-weight=\\"700\\">Strikes: 2</text>\\n\\n    <rect x=\\"766\\" y=\\"350\\" width=\\"260\\" height=\\"54\\" rx=\\"27\\" fill=\\"#89dceb\\" opacity=\\"0.2\\"/>\\n    <text x=\\"896\\" y=\\"384\\" text-anchor=\\"middle\\" fill=\\"#89dceb\\" font-size=\\"22\\" font-family=\\"Inter,Segoe UI,sans-serif\\" font-weight=\\"700\\">Tasks Done: 1</text>\\n\\n    <text x=\\"92\\" y=\\"470\\" fill=\\"#89dceb\\" font-size=\\"30\\" font-family=\\"JetBrains Mono,monospace\\" font-weight=\\"700\\">Blossoming Sekai's Miku</text>\\n    <text x=\\"92\\" y=\\"506\\" fill=\\"#a6adc8\\" font-size=\\"20\\" font-family=\\"Inter,Segoe UI,sans-serif\\">Joined: 1/10/2026 • Cute Profile Card</text>\\n    <text x=\\"92\\" y=\\"540\\" fill=\\"#cdd6f4\\" font-size=\\"18\\" font-family=\\"Inter,Segoe UI,sans-serif\\">💫 🌸 Hatsune Miku Superfan Deluxe has so much potential! Miku believes in you and your amazing comeback story~ ⭐</text>\\n</svg>",
  "cache": "public, max-age=300",
  "discord": [
    "/api/v10/users/100000000000000003",
    "/api/v10/guilds/900000000000000004/members/100000000000000003",
    "/api/v10/guilds/900000000000000004/roles",
    "/api/v10/guilds/900000000000000004/members?limit=1000"
  ],
  "errors": [],
  "renders": [],
  "status": 200,
  "type": "image/svg+xml; charset=utf-8"
}
`;

