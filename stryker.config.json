{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "mutate": ["Utils/domain/**/*.ts", "Services/**/*.ts", "!Services/index.ts"],
  "tap": {
    "testFiles": ["tests/domain/*.test.js", "tests/services/*.test.js"],
    "nodeArgs": ["--experimental-test-module-mocks", "--test-reporter=tap", "--require", "{{hookFile}}", "{{testFile}}"]
  },
  "coverageAnalysis": "perTest",
  "ignorePatterns": ["coverage", "reports", "backups", ".information"],
  "thresholds": { "high": 100, "low": 95, "break": 95 },
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always"
}
